# Copie ce fichier en ".env" et remplis les valeurs
# https://discord.com/developers/applications

# Onglet "Bot" > Reset Token
DISCORD_TOKEN=
# Onglet "General Information" > Application ID
CLIENT_ID=
# Clic droit sur le serveur > Copier l'identifiant (mode développeur activé)
GUILD_ID=
# Clic droit sur le salon de logs > Copier l'identifiant
LOG_CHANNEL_ID=
# (optionnel) Rôles exemptés de l'automod, séparés par des virgules
EXEMPT_ROLE_IDS=
# Chaîne Twitch + salon renommé En ligne / Hors ligne
TWITCH_LOGIN=
LIVE_STATUS_CHANNEL_ID=
# Salon des annonces de live (ping @everyone)
LIVE_ANNOUNCE_CHANNEL_ID=
# (optionnel) API Twitch officielle : https://dev.twitch.tv/console/apps — sinon decapi.me est utilisé
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Salon piège anti-bots (puis /setup-honeypot dedans)
HONEYPOT_CHANNEL_ID=
# Salon de bienvenue (image générée à chaque arrivée)
WELCOME_CHANNEL_ID=
# Salon du planning (/planning-modifier)
PLANNING_CHANNEL_ID=
# Salon où les nouveaux clips Twitch sont postés
CLIPS_CHANNEL_ID=
# Rôle donné au streamer pendant le live (sous le rôle du bot)
LIVE_ROLE_ID=
# (optionnel) Compte Discord du streamer, par défaut le propriétaire du serveur
STREAMER_USER_ID=
# Salon privé du casier des sanctions (lu par /sanctions)
SANCTIONS_CHANNEL_ID=
# Rôle donné automatiquement à chaque arrivée (ex : Followers)
AUTO_ROLE_ID=
# Salon où sont fêtés les paliers de followers Twitch (300, 350…)
MILESTONES_CHANNEL_ID=
